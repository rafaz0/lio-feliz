# Lio Feliz — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.

# === Nitro (obrigatório no Vercel) ===
# Define o preset de build do Nitro. No Vercel, deve ser "vercel".
# Local: não precisa definir (usa cloudflare-module como default).
NITRO_PRESET=vercel

# === Supabase (obrigatório) ===
# SUPABASE_URL em produção: https://<project-ref>.supabase.co (URL direta)
# SUPABASE_URL em dev/Lovable: https://c--<uuid>-prod.lovable.cloud (proxy Lovable)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# === BRAPI (obrigatório para cotações B3) ===
BRAPI_TOKEN=

# === bolsai (obrigatório para indicadores fundamentalistas) ===
# Plano gratuito: 200 req/dia. Plano Pro (R$49/mês): 10k req/dia.
# Chave: https://usebolsai.com/dashboard
BOLSAI_API_KEY=

# === Stripe (opcional — apenas se usar pagamentos reais) ===
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# === Asaas (gateway de pagamento real escolhido — Pix) ===
# Define qual gateway o checkout usa de verdade. Sem isso, continua "mock"
# (aprova só plano Free; qualquer cobrança > 0 é recusada fora de DEV).
PAYMENT_GATEWAY_PROVIDER=mock
# sandbox = https://api-sandbox.asaas.com (conta separada da produção,
# precisa ser criada à parte) | production = https://api.asaas.com
ASAAS_ENV=sandbox
# A chave do Asaas começa com "$" (ex: $aact_hmlg_... ou $aact_prod_...).
# Escape como \$aact_... — sem isso, o loader de env deste projeto tenta
# expandir como referência a outra variável e a chave vira string vazia
# (bug real, gastei tempo debugando isso em 06/08/2026). Aspas simples NÃO
# resolvem — só o escape com barra invertida.
ASAAS_API_KEY=
# Token que você mesmo define ao cadastrar o webhook no painel/API do
# Asaas — não é a API key. Vem de volta no header "asaas-access-token"
# em toda notificação, é como o endpoint valida que é o Asaas de verdade.
ASAAS_WEBHOOK_TOKEN=

# === Modo de Desenvolvimento ===
# true = usa store em memória (sem Supabase). false = usa Supabase real.
DEV_MODE=true

# === Sentry (opcional, recomendado para produção) ===
SENTRY_DSN=
